rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == "admin";
    }

    function isStaff() {
      return isAuthenticated() && getUserData().role == "staff";
    }

    function isCustomer() {
      return isAuthenticated() && getUserData().role == "customer";
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===========================
    // USERS
    // ===========================

    match /users/{userId} {

      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId);

      allow update: if isOwner(userId) || isAdmin();

      allow delete: if isAdmin();
    }

    // ===========================
    // COUNTERS
    // ===========================

    match /counters/{year} {

      allow read: if isAuthenticated();

      allow write: if isAdmin();
    }

    // ===========================
    // CUSTOMERS
    // ===========================

    match /customers/{customerId} {

      allow read: if isAdmin()
        || (isStaff() && request.auth.uid in resource.data.assignedStaffIds)
        || (isCustomer() && resource.data.firebaseUid == request.auth.uid);

      allow write: if isAdmin();
    }

    // ===========================
    // STAFF
    // ===========================

    match /staff/{staffId} {

      // Read own profile
      allow read: if isAdmin()
        || (
          isAuthenticated()
          && resource.data.firebaseUid == request.auth.uid
        );

      // Admin always allowed
      allow create, delete: if isAdmin();

      // Updates
      allow update: if

        // Admin
        isAdmin()

        ||

        // First Login
        (
          isAuthenticated()
          && resource.data.firebaseUid == null
          && request.resource.data.firebaseUid == request.auth.uid
          && request.resource.data.profileCompleted == true
        )

        ||

        // Existing Staff
        (
          isAuthenticated()
          && resource.data.firebaseUid == request.auth.uid
        );
    }

    // ===========================
    // ADMINS
    // ===========================

    match /admins/{adminId} {

      allow read: if isAdmin();

      allow write: if isAdmin();
    }

    // ===========================
    // PROJECTS
    // ===========================

    match /projects/{projectId} {

      allow read: if isAdmin()
        || (isStaff() && request.auth.uid in resource.data.assignedStaffIds)
        || (isCustomer() && resource.data.customerId == getUserData().entityId);

      allow create, update: if isAdmin() || isStaff();

      allow delete: if isAdmin();
    }

    // ===========================
    // PAYMENTS
    // ===========================

    match /payments/{paymentId} {

      allow read: if isAdmin()
        || isStaff()
        || (isCustomer() && resource.data.customerId == getUserData().entityId);

      allow write: if isAdmin();
    }

    // ===========================
    // PAYMENT REQUESTS
    // ===========================

    match /paymentRequests/{requestId} {

      allow read: if isAdmin()
        || (isCustomer() && resource.data.customerId == getUserData().entityId);

      allow create: if isCustomer();

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // ===========================
    // MILESTONES
    // ===========================

    match /milestones/{milestoneId} {

      allow read: if isAdmin() || isStaff() || isCustomer();

      allow write: if isAdmin() || isStaff();
    }

    // ===========================
    // DOCUMENTS
    // ===========================

    match /documents/{documentId} {

      allow read: if isAdmin() || isStaff() || isCustomer();

      allow write: if isAdmin() || isStaff();
    }

    // ===========================
    // REVIEWS
    // ===========================

    match /reviews/{reviewId} {

      allow read: if resource.data.status == "approved"
        || isAuthenticated();

      allow create: if true;

      allow update, delete: if isAdmin();
    }

    // ===========================
    // ACTIVITY LOGS
    // ===========================

    match /activityLogs/{logId} {

      allow read: if isAdmin();

      allow create: if isAuthenticated();

      allow update, delete: if isAdmin();
    }

    // ===========================
    // NOTIFICATIONS
    // ===========================

    match /notifications/{notificationId} {

      allow read, update: if isOwner(resource.data.userId);

      allow create: if isAuthenticated();

      allow delete: if isAdmin();
    }

    // ===========================
    // SETTINGS
    // ===========================

    match /settings/{settingId} {

      allow read: if isAuthenticated();

      allow write: if isAdmin();
    }
  }
}